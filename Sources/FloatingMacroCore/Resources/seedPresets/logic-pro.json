          "id": "b-lp-play",
          "label": "再生/停止",
          "backgroundColor": "#009E73",
          "textColor": "#FFFFFF",
          "iconText": "▶",
          "action": { "type": "key", "combo": "space" }
        },
        {
          "id": "b-lp-rec",
          "label": "録音",
          "backgroundColor": "#D55E00",
          "textColor": "#FFFFFF",
          "iconText": "⏺",
